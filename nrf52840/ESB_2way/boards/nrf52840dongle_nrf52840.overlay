/ {
    buttons {
        compatible = "gpio-keys";

        button0: button_0 {
            gpios = <&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Push button";
        };
    };

    aliases {
        sw0 = &button0;
    };
};
